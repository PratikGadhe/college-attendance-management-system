# Root .gitignore for Attendance Management System

# Environment variables & secrets
.env
.env.local
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local
frontend/.env.*.local
!backend/.env.example
!frontend/.env.example

# Virtual environments
.venv/
venv/
ENV/
backend/.venv/
backend/venv/

# Dependencies & Build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/

# Python cache
__pycache__/
*.py[cod]
*$py.class
backend/**/__pycache__/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Temporary & scratch files
scratch/

